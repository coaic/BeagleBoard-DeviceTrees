/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/am33xx.h>

/ {
    fragment@0 {
        target = <&am33xx_pinmux>;
        __overlay__ {
            spi1_pins: spi1_pins {
                pinctrl-single,pins = <
                    0x190 (PIN_INPUT_PULLUP | MUX_MODE3) /* P9_31 spi1_sclk */
                    0x194 (PIN_INPUT_PULLUP | MUX_MODE3) /* P9_29 spi1_d0 (MISO) */
                    0x198 (PIN_OUTPUT | MUX_MODE3)       /* P9_30 spi1_d1 (MOSI) */
                    0x19c (PIN_OUTPUT | MUX_MODE3)       /* P9_28 spi1_cs0 */
                >;
            };
        };
    };

    fragment@1 {
        target = <&spi1>;
        __overlay__ {
            status = "okay";
            pinctrl-names = "default";
            pinctrl-0 = <&spi1_pins>;

            #address-cells = <1>;
            #size-cells = <0>;

            spidev@0 {
                compatible = "rohm,dh2228fv";
                reg = <0>;
                spi-max-frequency = <1000000>;
            };
        };
    };
};
