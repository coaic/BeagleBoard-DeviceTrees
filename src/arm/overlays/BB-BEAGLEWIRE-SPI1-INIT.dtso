/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

/ {
    compatible = "ti,beaglebone", "ti,beaglebone-black";

    /* Hold flash reset high */
    fragment@0 {
        target = <&gpio3>;
        __overlay__ {
            flash_reset {
                gpio-hog;
                gpios = <21 GPIO_ACTIVE_HIGH>; /* P9_25 */
                output-high;
                line-name = "spi-flash-reset";
            };
        };
    };

    /* Bitbanged SPI master */
    fragment@1 {
        target-path = "/";
        __overlay__ {
            spi_gpio: spi-gpio {
                compatible = "spi-gpio";
                #address-cells = <1>;
                #size-cells = <0>;

                sck-gpios  = <&gpio3 14 GPIO_ACTIVE_HIGH>; /* P9_31 - SCLK */
                mosi-gpios = <&gpio3 15 GPIO_ACTIVE_HIGH>; /* P9_29 - MOSI */
                miso-gpios = <&gpio3 16 GPIO_ACTIVE_HIGH>; /* P9_30 - MISO */
                cs-gpios   = <&gpio3 17 GPIO_ACTIVE_LOW>;  /* P9_28 - CS */

                status = "okay";

                spidev@0 {
                    compatible = "spidev";
                    reg = <0>;
                    spi-max-frequency = <1000000>;
                };
            };
        };
    };
};