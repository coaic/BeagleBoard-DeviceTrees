/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

// SPDX-License-Identifier: GPL-2.0-only
/dts-v1/;
/plugin/;

/ {
    compatible = "ti,beaglebone", "ti,beaglebone-black";

    /* Hold flash reset high */
    fragment@0 {
        target = <&gpio3>;
        __overlay__ {
            flash_reset {
                gpio-hog;
                gpios = <21 GPIO_ACTIVE_HIGH>; /* P9_25 */
                output-high;
                line-name = "spi-flash-reset";
            };
        };
    };

    /* Expose raw spidev (no spi1, no pinmux) */
    fragment@1 {
        target-path = "/";
        __overlay__ {
            bw_flash {
                compatible = "spidev";
                spi-max-frequency = <1000000>;
                status = "okay";
            };
        };
    };
};
