/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

/ {
    fragment@0 {
        target = <&gpio3>;
        __overlay__ {
            ice40_creset {
                /* gpio-hog; */
                /* gpios = <21 GPIO_ACTIVE_HIGH>; */ /* P9_25 */
                gpios = <&gpios3 21 GPIO_ACTIVE_HIGH>; /* P9_25 */
                /* output-low; */                   /* HOLD FPGA IN RESET */
                line-name = "ice40_creset";
            };
        };
    };

    /* Bitbanged SPI master */
    fragment@1 {
        target-path = "/";
        __overlay__ {
            spi_gpio: spi-gpio {
                compatible = "spi-gpio";
                #address-cells = <1>;
                #size-cells = <0>;

                sck-gpios  = <&gpio3 14 GPIO_ACTIVE_HIGH>; /* P9_31 - SCLK */
                mosi-gpios = <&gpio3 15 GPIO_ACTIVE_HIGH>; /* P9_29 - MOSI */
                miso-gpios = <&gpio3 16 GPIO_ACTIVE_HIGH>; /* P9_30 - MISO */
                cs-gpios   = <&gpio3 17 GPIO_ACTIVE_LOW>;  /* P9_28 - CS */

                status = "okay";

                spidev@0 {
                    compatible = "linux,spidev";
                    reg = <0>;
                    spi-max-frequency = <1000000>;
                };
            };
        };
    };
};
