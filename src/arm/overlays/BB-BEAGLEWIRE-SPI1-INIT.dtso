/dts-v1/;
/plugin/;

/ {
    fragment@0 {
        target = <&gpio2>;
        __overlay__ {
            ice40_creset: ice40-creset {
                gpio-hog;
                gpios = <21 1>;      /* GPIO2_21, active-low */
                output-low;          /* assert reset */
                line-name = "ice40_creset";
            };
        };
    };
};